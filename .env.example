# Supabase Configuration
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are exposed to the client
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# SUPABASE_SERVICE_ROLE_KEY is strictly server-side ONLY. Never expose to client bundles or repo!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# App Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
