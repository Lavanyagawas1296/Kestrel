# ==========================================
# Kestrel Production Environment Variables
# Configure these in your Vercel Dashboard
# ==========================================

# 1. Supabase Connection (Required for live multi-tenant storage & RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Supabase URL and Publishable Key fallback names (also supported):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# 2. Google Gemini API Key (Required for live LLM review checks & RAG grounding)
# Set your Gemini API key from Google AI Studio. Never print or log this secret.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Storage Mode
# Keep false (or unset) in Vercel production to use Supabase with anonymous RLS sessions.
# Set true only for offline/local unit tests.
USE_PGLITE=false

# 4. App URL
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app
